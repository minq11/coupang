# 가상환경 / 캐시
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# 로컬 설정
.env

# GUI 실행 로그 (common.py 가 매 실행마다 덮어쓰기, work/<job_id>/run.log 는 Job 폴더 안)
logs/

# 모델 가중치 / Job 산출물 (용량 큼)
models/*
!models/.gitkeep
work/*
!work/.gitkeep
third_party/

# 테스트 입력 이미지는 사용자가 직접 넣는다 (README 참고). 작은 합성 샘플만 커밋.
samples/*
!samples/.gitkeep
!samples/README.md

# Gradio
flagged/
