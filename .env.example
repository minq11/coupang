# .env 로 복사해서 쓴다. 전부 선택 사항.

# Hugging Face 캐시 위치 (기본: ~/.cache/huggingface). 용량 큰 드라이브로 옮길 때.
# HF_HOME=D:/hf_cache

# 가중치 저장 폴더 (기본: <repo>/models)
# VR180_MODELS_DIR=D:/vr180_models

# Job 산출물 폴더 (기본: <repo>/work)
# VR180_WORK_DIR=D:/vr180_work

# 게이트된 모델(FLUX.1 Fill dev 등) 받을 때 필요
# HF_TOKEN=hf_xxx

# GUI 포트
# VR180_GUI_PORT=7860
