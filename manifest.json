{
  "manifest_version": 3,
  "name": "쿠팡 순위 파인더",
  "version": "0.4.0",
  "description": "쿠팡 검색결과 페이지에서 내 상품이 몇 위인지 확인하는 셀러용 도구",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["https://api-gateway.coupang.com/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.coupang.com/np/search*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "쿠팡 순위 파인더",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
